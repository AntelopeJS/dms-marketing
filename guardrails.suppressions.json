{
  "rules": {
    "anti-slop/no-chained-type-assertions": 1,
    "anti-slop/no-object-parameters": 1,
    "eslint/max-params": 2,
    "typescript/no-explicit-any": 1,
    "typescript/no-require-imports": 0,
    "typescript/unbound-method": 4
  },
  "tsExpectError": 0,
  "tsIgnore": 0,
  "safety": 0,
  "config": {
    "typescript/restrict-template-expressions for packages/dms-marketing/tests/**/*.js": 1,
    "vue/multi-word-component-names for packages/dms-marketing/frontend-vue/**/*.ts": 1,
    "vue/multi-word-component-names for packages/dms-marketing/frontend-vue/**/*.vue": 1
  }
}
