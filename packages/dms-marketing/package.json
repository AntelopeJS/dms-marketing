{
  "name": "@antelopejs/dms-marketing",
  "version": "0.5.0",
  "description": "First-party marketing analytics for the AntelopeJS DMS: traffic dashboards, conversion funnels with A/B splits and click heatmaps, without cookies or external services.",
  "keywords": [
    "ab-testing",
    "analytics",
    "antelopejs",
    "dms",
    "dms-module",
    "heatmap",
    "marketing"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/marketing",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-marketing/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-marketing.git",
    "directory": "packages/dms-marketing"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills",
    "static"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-marketing build && rimraf dist && tsc",
    "test": "pnpm run test:backend && pnpm run test:layer",
    "test:backend": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && ajs module test .",
    "test:layer": "cd frontend-vue && pnpm test",
    "dev": "ajs project run -w -p playground",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "lint": "oxlint && oxfmt --check . && cd frontend-vue && pnpm lint && antelopejs-check-interface-ranges",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && cd frontend-vue && pnpm lint:fix",
    "format": "oxfmt . && cd frontend-vue && pnpm format",
    "release": "pnpm --filter @antelopejs/interface-dms-marketing build && pnpm --dir frontend-vue install --frozen-lockfile && pnpm run lint && release-it",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.2 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.3 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.2.0 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.8 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-dms": ">=0.7.0 <1.0.0",
    "@antelopejs/interface-dms-marketing": ">=0.4.0 <0.5.0",
    "defu": "^6.1.4",
    "maxmind": "^5.0.7",
    "node-cron": "^4.2.1",
    "sanitize-html": "^2.18.0",
    "ua-parser-js": "^2.0.9",
    "zod": "~3.24.4"
  },
  "devDependencies": {
    "@antelopejs/core": ">=1.15.2 <2",
    "@antelopejs/interface-mongodb": ">=0.0.5 <1.0.0",
    "@antelopejs/mongodb": "1.4.2",
    "@antelopejs/tooling-configs": ">=0.0.7 <1.0.0",
    "@types/node": "^22.19.15",
    "@types/sanitize-html": "^2.16.2",
    "knip": "^6.34.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server-core": "^10.4.3",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "baseUrl": "dist",
    "test": "antelope.test.ts",
    "implements": [
      "@antelopejs/interface-dms-marketing"
    ],
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "skills": [
      "./skills"
    ]
  }
}
