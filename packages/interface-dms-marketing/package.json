{
  "name": "@antelopejs/interface-dms-marketing",
  "version": "0.3.0",
  "description": "AntelopeJS interface for the DMS marketing module: read aggregated first-party analytics from any module",
  "keywords": [
    "analytics",
    "antelopejs",
    "dms",
    "interface",
    "marketing"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-marketing.git"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "release": "pnpm run lint && pnpm run build && release-it",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/node": "22.20.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "19.2.4",
    "release-it-changelogen": "0.1.0",
    "rimraf": "6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {}
}
