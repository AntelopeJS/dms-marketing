{
  "name": "@antelopejs/dms-marketing",
  "version": "0.7.1",
  "description": "First-party marketing analytics for the AntelopeJS DMS: traffic dashboards, conversion funnels with A/B splits and click heatmaps, without cookies or external services.",
  "keywords": [
    "ab-testing",
    "analytics",
    "antelopejs",
    "dms",
    "dms-module",
    "heatmap",
    "marketing"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/marketing",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-marketing/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-marketing.git",
    "directory": "packages/dms-marketing"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills",
    "static"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-marketing build && rimraf dist && tsc",
    "test": "pnpm run test:backend && pnpm run test:layer",
    "test:backend": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && ajs module test .",
    "test:layer": "cd frontend-vue && pnpm test",
    "dev": "ajs project run -w -p playground",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "release": "pnpm --filter @antelopejs/interface-dms-marketing build && pnpm --dir frontend-vue install --frozen-lockfile && pnpm --dir ../.. run lint && pnpm --dir ../.. run format:check && release-it",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-f2a99b5.tgz",
    "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-47a7df1.tgz",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
    "@antelopejs/interface-dms": "file:../../.campaign/tgz/antelopejs-interface-dms-e0787e6.tgz",
    "@antelopejs/interface-dms-marketing": "file:../../.campaign/tgz/antelopejs-interface-dms-marketing-ece90b2.tgz",
    "defu": "^6.1.4",
    "maxmind": "^5.0.7",
    "node-cron": "^4.2.1",
    "sanitize-html": "^2.18.0",
    "ua-parser-js": "^2.0.9",
    "zod": "~3.24.4"
  },
  "devDependencies": {
    "@antelopejs/core": ">=1.17.1 <2",
    "@antelopejs/interface-mongodb": ">=0.0.6 <1.0.0",
    "@antelopejs/mongodb": "file:../../.campaign/tgz/antelopejs-mongodb-db4b449.tgz",
    "@antelopejs/tooling-configs": "^0.2.11",
    "@types/node": "^22.19.15",
    "@types/sanitize-html": "^2.16.2",
    "knip": "^6.34.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server-core": "^10.4.3",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
      "@antelopejs/mongodb": "file:../../.campaign/tgz/antelopejs-mongodb-db4b449.tgz",
      "@antelopejs/mongodb>@antelopejs/interface-core": "0.2.4",
      "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
      "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-f2a99b5.tgz",
      "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-47a7df1.tgz",
      "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
      "@antelopejs/interface-dms": "file:../../.campaign/tgz/antelopejs-interface-dms-e0787e6.tgz",
      "@antelopejs/interface-dms-marketing": "file:../../.campaign/tgz/antelopejs-interface-dms-marketing-ece90b2.tgz"
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "test": "antelope.test.ts",
    "implements": [
      "@antelopejs/interface-dms-marketing"
    ],
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
