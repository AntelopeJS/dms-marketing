    "eslint": "^10.9.1",
    "jsdom": "^26.1.0",
    "ofetch": "^1.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": ">=8.3.4 <8.4.0",
    "vitest": "^4.1.5"
